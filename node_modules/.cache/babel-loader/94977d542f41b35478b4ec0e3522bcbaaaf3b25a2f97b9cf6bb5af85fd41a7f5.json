{"ast":null,"code":"import CalculateMonthly from '@/components/CalculateMonthly.vue';\nimport CalculateLoanAmount from '@/components/CalculateLoanAmount.vue';\nexport default {\n  name: 'CalculateTabs',\n  components: {\n    CalculateMonthly,\n    CalculateLoanAmount\n  }\n};","map":{"version":3,"names":["CalculateMonthly","CalculateLoanAmount","name","components"],"sources":["src/views/CalculateTabs.vue"],"sourcesContent":["<template>\n  <div>\n    <!-- Header Section with Full Background Color -->\n    <header class=\"header-section\">\n      <img src=\"../assets/banner-image.png\" alt=\"Website Header Image\" class=\"header-image\" />\n      <div class=\"header-text\">\n        <h1>คำนวณเงินกู้ซื้อคอนโด คำนวณสินเชื่อเบื้องต้น.</h1>\n      </div>\n    </header>\n\n    <!-- Container with Background Color -->\n    <div class=\"container-fluid bg-light\"> <!-- Added background color class here -->\n      <div class=\"container\">\n        <div class=\"text-center p-5 mb-5\">\n          <div class=\"word-break\">\n            โปรแกรมช่วยคำนวณสินเชื่อคอนโด ช่วยให้คุณคาดการณ์ยอดกู้และค่างวดผ่อนต่อเดือนได้ง่ายๆ\n          </div>\n\n          <div class=\"word-break\">\n            ไม่ว่าจะเป็นการกู้ซื้อคอนโด หรือรีไฟแนนซ์ เพียงกรอกข้อมูลดอกเบี้ย วงเงิน และระยะเวลาผ่อน\n          </div>\n\n          <div class=\"word-break\">\n            ระบบจะช่วยแนะนำโครงการและสินเชื่อที่เหมาะสมกับคุณ พร้อมปรับให้สอดคล้องกับรายได้\n          </div>\n\n          <div class=\"word-break\">\n            และความสามารถในการผ่อนชำระของคุณ\n          </div>\n        </div>\n\n        <ul class=\"nav nav-tabs\" id=\"pills-tab\" role=\"tablist\">\n          <li class=\"nav-item\" role=\"presentation\">\n            <button class=\"nav-link active m-1\" id=\"profile-tab\" data-bs-toggle=\"tab\" data-bs-target=\"#profile-tab-pane\"\n              type=\"button\" role=\"tab\" aria-controls=\"profile-tab-pane\"\n              aria-selected=\"false\">คำนวณวงเงินที่สามารถกู้ได้สูงสุด</button>\n          </li>\n          <li class=\"nav-item\" role=\"presentation\">\n            <button class=\"nav-link  m-1\" id=\"home-tab\" data-bs-toggle=\"tab\" data-bs-target=\"#home-tab-pane\" type=\"button\"\n              role=\"tab\" aria-controls=\"home-tab-pane\" aria-selected=\"true\">คำนวณการผ่อนต่อเดือน</button>\n          </li>\n        </ul>\n        <div class=\"tab-content bg-white\" id=\"myTabContent\">\n          <div class=\"tab-pane fade show active\" id=\"profile-tab-pane\" role=\"tabpanel\" aria-labelledby=\"profile-tab\"\n            tabindex=\"0\">\n            <CalculateLoanAmount />\n          </div>\n          <div class=\"tab-pane fade \" id=\"home-tab-pane\" role=\"tabpanel\" aria-labelledby=\"home-tab\" tabindex=\"0\">\n            <CalculateMonthly />\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport CalculateMonthly from '@/components/CalculateMonthly.vue';\nimport CalculateLoanAmount from '@/components/CalculateLoanAmount.vue';\n\nexport default {\n  name: 'CalculateTabs',\n  components: {\n    CalculateMonthly,\n    CalculateLoanAmount,\n  },\n};\n</script>\n\n<style scoped>\n.bg-white {\n  background-color: white;\n  padding: 6px;\n}\n\n.header-section {\n  width: 100%;\n  position: relative;\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  text-align: center;\n}\n\n.header-image {\n  width: 100%;\n  height: auto;\n  object-fit: cover;\n  display: block;\n  max-height: 450px; \n  transition: max-height 0.3s ease;\n}\n\n.header-text {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  transform: translate(-50%, -50%);\n  color: #000000;\n  text-align: center;\n  padding: 0 20px;\n  z-index: 1;\n}\n\n.header-text h1 {\n  font-size: 2rem;\n  margin-bottom: 10px;\n}\n\n.header-text p {\n  font-size: 1rem;\n  margin-top: 0;\n}\n\n.bg-light {\n  background-color: #f8f9f9 !important;\n}\n\n/* Make image square on smaller screens */\n@media (max-width: 768px) {\n  .header-image {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    min-height: 300px;\n  }\n\n  .header-text h1 {\n    font-size: 1.5rem; \n  }\n\n  .header-text p {\n    font-size: 0.875rem; \n  }\n}\n\n@media (max-width: 480px) {\n  .header-image {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    min-height: 250px; /* Keeps it square for smaller screens */\n  }\n\n  .header-text h1 {\n    font-size: 1.2rem;\n  }\n\n  .header-text p {\n    font-size: 0.75rem;\n  }\n}\n</style>\n"],"mappings":"AAyDA,OAAAA,gBAAA;AACA,OAAAC,mBAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAH,gBAAA;IACAC;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}