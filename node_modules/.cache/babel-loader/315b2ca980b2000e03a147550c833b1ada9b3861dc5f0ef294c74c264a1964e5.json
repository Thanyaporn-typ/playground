{"ast":null,"code":"import \"core-js/modules/esnext.iterator.constructor.js\";\nimport \"core-js/modules/esnext.iterator.for-each.js\";\nimport { mockStock, mockReset } from '@/mock/mock-spin';\n\n// ✅ toggle\nconst USE_MOCK = true;\nexport default {\n  data() {\n    return {\n      eventDay: 1,\n      stock: [],\n      interval: null // ✅ กัน memory leak\n    };\n  },\n  watch: {\n    stock: {\n      handler(newVal) {\n        newVal.forEach(item => {\n          if (item.remain === 0) {\n            console.warn('ของหมด:', item.name);\n          }\n        });\n      },\n      deep: true\n    }\n  },\n  mounted() {\n    this.fetchStock();\n\n    // realtime\n    this.interval = setInterval(this.fetchStock, 3000);\n  },\n  beforeDestroy() {\n    // ✅ สำคัญมาก (กัน setInterval ค้าง)\n    clearInterval(this.interval);\n  },\n  methods: {\n    async fetchStock() {\n      try {\n        if (USE_MOCK) {\n          this.stock = await mockStock();\n        } else {\n          const res = await fetch(`/api/spin/stock?event_day=${this.eventDay}`);\n          this.stock = await res.json();\n        }\n      } catch (err) {\n        console.error('fetchStock error:', err);\n      }\n    },\n    async resetStock() {\n      if (!confirm('Reset stock ?')) return;\n      if (USE_MOCK) {\n        mockReset();\n        this.fetchStock();\n      } else {\n        await fetch('/api/spin/reset', {\n          method: 'POST',\n          headers: {\n            'Content-Type': 'application/json'\n          },\n          body: JSON.stringify({\n            event_day: this.eventDay\n          })\n        });\n        this.fetchStock();\n      }\n    },\n    // ✅ กัน total undefined\n    getPercent(item) {\n      const total = item.total || 500; // fallback\n      return item.remain / total * 100;\n    }\n  }\n};","map":{"version":3,"names":["mockStock","mockReset","USE_MOCK","data","eventDay","stock","interval","watch","handler","newVal","forEach","item","remain","console","warn","name","deep","mounted","fetchStock","setInterval","beforeDestroy","clearInterval","methods","res","fetch","json","err","error","resetStock","confirm","method","headers","body","JSON","stringify","event_day","getPercent","total"],"sources":["src/views/SpinDashboard.vue"],"sourcesContent":["<template>\n    <div class=\"container py-4\">\n\n        <h2>📊 Dashboard</h2>\n\n        <div class=\"mb-3\">\n            <button class=\"btn btn-primary me-2\" @click=\"fetchStock\">\n                Refresh\n            </button>\n\n            <button class=\"btn btn-danger\" @click=\"resetStock\">\n                Reset\n            </button>\n        </div>\n\n        <div class=\"row\">\n            <div class=\"col-md-3 mb-3\" v-for=\"item in stock\" :key=\"item.id\">\n                <div class=\"card p-3 text-center shadow\">\n                    <h6>{{ item.name }}</h6>\n\n                    <h2 :class=\"item.remain <= 5 ? 'text-danger' : 'text-success'\">\n                        {{ item.remain }}\n                    </h2>\n\n                    <div class=\"progress mt-2\">\n                        <div class=\"progress-bar\" :class=\"item.remain <= 5 ? 'bg-danger' : 'bg-success'\"\n                            :style=\"{ width: getPercent(item) + '%' }\">\n                        </div>\n                    </div>\n\n                    <small class=\"text-muted\">\n                        ใช้ไป {{ (item.total || 500) - item.remain }} ชิ้น\n                    </small>\n\n                </div>\n            </div>\n        </div>\n\n    </div>\n</template>\n  \n<script>\nimport { mockStock, mockReset } from '@/mock/mock-spin'\n\n// ✅ toggle\nconst USE_MOCK = true\n\nexport default {\n    data() {\n        return {\n            eventDay: 1,\n            stock: [],\n            interval: null // ✅ กัน memory leak\n        }\n    },\n    watch: {\n        stock: {\n            handler(newVal) {\n                newVal.forEach(item => {\n                    if (item.remain === 0) {\n                        console.warn('ของหมด:', item.name)\n                    }\n                })\n            },\n            deep: true\n        }\n    },\n\n    mounted() {\n        this.fetchStock()\n\n        // realtime\n        this.interval = setInterval(this.fetchStock, 3000)\n    },\n\n    beforeDestroy() {\n        // ✅ สำคัญมาก (กัน setInterval ค้าง)\n        clearInterval(this.interval)\n    },\n\n    methods: {\n        async fetchStock() {\n            try {\n                if (USE_MOCK) {\n                    this.stock = await mockStock()\n                } else {\n                    const res = await fetch(`/api/spin/stock?event_day=${this.eventDay}`)\n                    this.stock = await res.json()\n                }\n            } catch (err) {\n                console.error('fetchStock error:', err)\n            }\n        },\n\n        async resetStock() {\n            if (!confirm('Reset stock ?')) return\n\n            if (USE_MOCK) {\n                mockReset()\n                this.fetchStock()\n            } else {\n                await fetch('/api/spin/reset', {\n                    method: 'POST',\n                    headers: { 'Content-Type': 'application/json' },\n                    body: JSON.stringify({ event_day: this.eventDay })\n                })\n\n                this.fetchStock()\n            }\n        },\n\n        // ✅ กัน total undefined\n        getPercent(item) {\n            const total = item.total || 500 // fallback\n            return (item.remain / total) * 100\n        }\n    }\n}\n</script>"],"mappings":";;AA0CA,SAAAA,SAAA,EAAAC,SAAA;;AAEA;AACA,MAAAC,QAAA;AAEA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,KAAA;MACAC,QAAA;IACA;EACA;EACAC,KAAA;IACAF,KAAA;MACAG,QAAAC,MAAA;QACAA,MAAA,CAAAC,OAAA,CAAAC,IAAA;UACA,IAAAA,IAAA,CAAAC,MAAA;YACAC,OAAA,CAAAC,IAAA,YAAAH,IAAA,CAAAI,IAAA;UACA;QACA;MACA;MACAC,IAAA;IACA;EACA;EAEAC,QAAA;IACA,KAAAC,UAAA;;IAEA;IACA,KAAAZ,QAAA,GAAAa,WAAA,MAAAD,UAAA;EACA;EAEAE,cAAA;IACA;IACAC,aAAA,MA